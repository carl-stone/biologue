{
  "name": "carl-harness",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && npm run build -w @carl/workbench && npm run build -w @carl/server",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "tsx --test packages/server/test/*.test.ts",
    "test:integration": "tsx --test packages/server/test/integration/*.test.ts",
    "test:ui": "playwright test",
    "start": "node packages/server/dist/server.mjs",
    "serve": "node scripts/dev.mjs --production",
    "login:codex": "node scripts/login-codex.mjs",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.12",
    "prettier": "^3.9.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
