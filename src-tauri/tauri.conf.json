{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Biologue",
  "version": "0.1.0",
  "identifier": "science.biologue.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../packages/workbench/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Biologue — Scientific workspace",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:4317 ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
